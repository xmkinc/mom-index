{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmkinc.github.io/mom-index/schema/dashboard.schema.json",
  "title": "Mom Index public dashboard payload v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "display_timezone",
    "sources",
    "freshness",
    "warnings",
    "methodology",
    "latest",
    "sector_history",
    "market_context",
    "record_count"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "generated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "display_timezone": {
      "const": "Asia/Shanghai"
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "freshness": {
      "$ref": "#/$defs/freshness"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "methodology": {
      "$ref": "#/$defs/methodology"
    },
    "latest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/latest"
        }
      ]
    },
    "sector_history": {
      "$ref": "#/$defs/sectorHistory"
    },
    "market_context": {
      "$ref": "#/$defs/marketContext"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "mode",
        "collected_at",
        "post_count",
        "errors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mode": {
          "enum": [
            "live",
            "imported",
            "simulated",
            "unavailable"
          ]
        },
        "collected_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "post_count": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "unavailable"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "collected_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "collected_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      ]
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_stale",
        "last_success_at",
        "stale_after_hours"
      ],
      "properties": {
        "is_stale": {
          "type": "boolean"
        },
        "last_success_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "stale_after_hours": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formula_version",
        "confidence_model_version",
        "weights"
      ],
      "properties": {
        "formula_version": {
          "const": "1.1"
        },
        "confidence_model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "newbie_ratio",
            "newbie_intensity",
            "sentiment_extremity",
            "purity"
          ],
          "properties": {
            "newbie_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "newbie_intensity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sentiment_extremity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "purity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "activity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "latest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "sectors"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "sectors": {
          "$ref": "#/$defs/sectors"
        }
      }
    },
    "sectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nasdaq",
        "gold",
        "cpo",
        "semiconductor"
      ],
      "properties": {
        "nasdaq": {
          "$ref": "#/$defs/sector"
        },
        "gold": {
          "$ref": "#/$defs/sector"
        },
        "cpo": {
          "$ref": "#/$defs/sector"
        },
        "semiconductor": {
          "$ref": "#/$defs/sector"
        }
      }
    },
    "sector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "interpretation",
        "details",
        "top_newbie_posts",
        "sample_quality"
      ],
      "properties": {
        "index": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "interpretation": {
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/details"
        },
        "top_newbie_posts": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/post"
          }
        },
        "sample_quality": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sampleQuality"
            }
          ]
        }
      }
    },
    "sampleQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_version",
        "confidence",
        "valid_sample_size",
        "title_only_ratio",
        "platform_counts",
        "classifier_evidence_coverage",
        "known_in_window_ratio",
        "unknown_time_ratio",
        "window_hours",
        "reason_codes"
      ],
      "properties": {
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "valid_sample_size": {
          "type": "integer",
          "minimum": 0
        },
        "title_only_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "platform_counts": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "classifier_evidence_coverage": {
          "$ref": "#/$defs/ratio"
        },
        "known_in_window_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "unknown_time_ratio": {
          "$ref": "#/$defs/ratio"
        },
        "window_hours": {
          "type": "integer",
          "minimum": 1
        },
        "reason_codes": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_posts",
        "valid_posts",
        "spam_posts",
        "newbie_posts",
        "pure_newbie",
        "newbie_ratio",
        "avg_newbie_score",
        "avg_sentiment",
        "purity_signal",
        "mom_buy_index",
        "mom_sell_index",
        "buy_sell_ratio",
        "buy_count",
        "sell_count"
      ],
      "properties": {
        "total_posts": {
          "type": "integer",
          "minimum": 0
        },
        "valid_posts": {
          "type": "integer",
          "minimum": 0
        },
        "spam_posts": {
          "type": "integer",
          "minimum": 0
        },
        "newbie_posts": {
          "type": "integer",
          "minimum": 0
        },
        "pure_newbie": {
          "type": "integer",
          "minimum": 0
        },
        "newbie_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "avg_newbie_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "avg_sentiment": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "purity_signal": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "activity": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mom_buy_index": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "mom_sell_index": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "buy_sell_ratio": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "buy_count": {
          "type": "integer",
          "minimum": 0
        },
        "sell_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "post": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "score",
        "level",
        "reasoning",
        "intent",
        "key_signals",
        "source_url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 60
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "type": "string"
        },
        "reasoning": {
          "type": "string",
          "maxLength": 150
        },
        "intent": {
          "enum": [
            "buy",
            "sell",
            "neutral"
          ]
        },
        "key_signals": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "maxLength": 160
          }
        },
        "source_url": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "type": "string",
              "format": "uri"
            }
          ]
        }
      }
    },
    "sectorHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nasdaq",
        "gold",
        "cpo",
        "semiconductor"
      ],
      "properties": {
        "nasdaq": {
          "$ref": "#/$defs/historyPoints"
        },
        "gold": {
          "$ref": "#/$defs/historyPoints"
        },
        "cpo": {
          "$ref": "#/$defs/historyPoints"
        },
        "semiconductor": {
          "$ref": "#/$defs/historyPoints"
        }
      }
    },
    "historyPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "index",
          "source_mode"
        ],
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "index": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "source_mode": {
            "enum": [
              "live",
              "imported",
              "simulated"
            ]
          }
        }
      }
    },
    "marketContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "provider",
        "imported_at",
        "errors",
        "sectors"
      ],
      "properties": {
        "status": {
          "enum": [
            "available",
            "degraded",
            "unavailable"
          ]
        },
        "provider": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          ]
        },
        "imported_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/timestamp"
            }
          ]
        },
        "errors": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "sectors": {
          "$ref": "#/$defs/marketSectors"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "provider": {
                "type": "null"
              },
              "imported_at": {
                "type": "null"
              },
              "sectors": {
                "properties": {
                  "nasdaq": {
                    "type": "null"
                  },
                  "gold": {
                    "type": "null"
                  },
                  "cpo": {
                    "type": "null"
                  },
                  "semiconductor": {
                    "type": "null"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "imported_at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sectors": {
                "properties": {
                  "nasdaq": {
                    "not": {
                      "type": "null"
                    }
                  },
                  "gold": {
                    "not": {
                      "type": "null"
                    }
                  },
                  "cpo": {
                    "not": {
                      "type": "null"
                    }
                  },
                  "semiconductor": {
                    "not": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "degraded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "sectors": {
                "not": {
                  "properties": {
                    "nasdaq": {
                      "type": "null"
                    },
                    "gold": {
                      "type": "null"
                    },
                    "cpo": {
                      "type": "null"
                    },
                    "semiconductor": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "marketSectors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nasdaq",
        "gold",
        "cpo",
        "semiconductor"
      ],
      "properties": {
        "nasdaq": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nasdaqMarketSector"
            }
          ]
        },
        "gold": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/goldMarketSector"
            }
          ]
        },
        "cpo": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/cpoMarketSector"
            }
          ]
        },
        "semiconductor": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/semiconductorMarketSector"
            }
          ]
        }
      }
    },
    "marketSector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "name",
        "as_of",
        "returns"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "returns": {
          "$ref": "#/$defs/marketReturns"
        }
      }
    },
    "nasdaqMarketSector": {
      "allOf": [
        {
          "$ref": "#/$defs/marketSector"
        },
        {
          "properties": {
            "symbol": {
              "const": "513100"
            },
            "name": {
              "const": "纳斯达克ETF"
            }
          }
        }
      ]
    },
    "goldMarketSector": {
      "allOf": [
        {
          "$ref": "#/$defs/marketSector"
        },
        {
          "properties": {
            "symbol": {
              "const": "518880"
            },
            "name": {
              "const": "黄金ETF"
            }
          }
        }
      ]
    },
    "cpoMarketSector": {
      "allOf": [
        {
          "$ref": "#/$defs/marketSector"
        },
        {
          "properties": {
            "symbol": {
              "const": "515880"
            },
            "name": {
              "const": "CPO通信ETF"
            }
          }
        }
      ]
    },
    "semiconductorMarketSector": {
      "allOf": [
        {
          "$ref": "#/$defs/marketSector"
        },
        {
          "properties": {
            "symbol": {
              "const": "512480"
            },
            "name": {
              "const": "半导体ETF"
            }
          }
        }
      ]
    },
    "marketReturns": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "1d": {
          "type": "number"
        },
        "5d": {
          "type": "number"
        },
        "20d": {
          "type": "number"
        }
      }
    }
  }
}
